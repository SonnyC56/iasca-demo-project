# Copy to infra/convex/.env (git-ignored). Pin tags before relying on this beyond local dev.
CONVEX_BACKEND_TAG=latest
CONVEX_DASHBOARD_TAG=latest
INSTANCE_NAME=iasca-crm-dev
# Generate once with: openssl rand -hex 32  (keeps admin keys stable if the volume is recreated)
INSTANCE_SECRET=
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
