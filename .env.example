# Written automatically by `npx convex dev` into .env.local (git-ignored).
#
# Option A — zero-setup local backend (default, no Docker, no account):
# CONVEX_DEPLOYMENT=anonymous:anonymous-iasca-demo-project
# VITE_CONVEX_URL=http://127.0.0.1:3210
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
#
# Option B — Docker self-hosted backend (infra/convex/docker-compose.yml).
# Do NOT set CONVEX_DEPLOYMENT together with these:
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=<output of generate_admin_key.sh>
# VITE_CONVEX_URL=http://127.0.0.1:3210
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
#
# Dev-only switches:
# VITE_CONVEX_PROXY=off   # connect straight to VITE_CONVEX_URL instead of via the Vite proxy
# DEV_HTTPS=1             # serve Vite over HTTPS (self-signed) — also via `pnpm dev:https`
