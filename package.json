{
  "name": "iasca-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p -l dev:backend dev:frontend",
    "dev:backend": "convex dev --typecheck=disable",
    "dev:frontend": "vite",
    "dev:lan": "node scripts/dev-lan.mjs && run-p -l dev:backend dev:frontend",
    "dev:https": "DEV_HTTPS=1 run-p -l dev:backend dev:frontend",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build && tsc -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@vueuse/core": "^15.0.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "convex-test": "^0.0.59",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.14",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@11.5.0"
}
